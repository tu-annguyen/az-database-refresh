{
  "buildCommand": "npm --workspace apps/web run build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/review/:path*",
      "destination": "/"
    },
    {
      "source": "/admin-review/:path*",
      "destination": "/"
    }
  ]
}
